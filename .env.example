# ==========================================================
# SUPABASE CONFIGURATION
# Found in: Supabase Dashboard -> Project Settings -> API
# ==========================================================
SUPABASE_URL=https://your-project-id.supabase.co
# Use service_role secret key for backend server (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Or anon public key (optional fallback)
SUPABASE_KEY=your-supabase-anon-key-here

# ==========================================================
# AUTHENTICATION & SECURITY
# ==========================================================
JWT_SECRET=capitol_library_management_system_secret_2026
GOOGLE_CLIENT_ID=537410929054-hccges6c28en60dkgl43llrqd875tp7p.apps.googleusercontent.com

# ==========================================================
# SERVER CONFIGURATION
# ==========================================================
PORT=5000
FRONTEND_URL=http://localhost:5173

# ==========================================================
# EMAIL NOTIFICATIONS (Nodemailer SMTP)
# ==========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Misamis Oriental Public Library <your-email@gmail.com>"

# ==========================================================
# OPEN LIBRARY INTEGRATION
# ==========================================================
OPENLIBRARY_USER_AGENT=Capitol Library Management System/1.0 (your-email@gmail.com)
