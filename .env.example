# ==========================================================
# SUPABASE CONFIGURATION
# Found in: Supabase Dashboard -> Project Settings -> API
# ==========================================================
SUPABASE_URL=https://your-project-id.supabase.co
# Use service_role secret key for backend server (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Or anon public key (optional fallback)
SUPABASE_KEY=your-supabase-anon-key-here

# ==========================================================
# AUTHENTICATION & SECURITY
# ==========================================================
JWT_SECRET=capitol_library_management_system_secret_2026
GOOGLE_CLIENT_ID=537410929054-hccges6c28en60dkgl43llrqd875tp7p.apps.googleusercontent.com

# ==========================================================
# SERVER CONFIGURATION
# ==========================================================
PORT=5000
FRONTEND_URL=http://localhost:5173

# ==========================================================
# Brevo (Sendinblue) Configuration
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_NAME="Misamis Oriental Public Library"
BREVO_SENDER_EMAIL=your-verified-sender@domain.com

# EMAIL NOTIFICATIONS (Nodemailer SMTP Fallback)
# ==========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Misamis Oriental Public Library <your-email@gmail.com>"

# ==========================================================
# OPEN LIBRARY INTEGRATION
# ==========================================================
OPENLIBRARY_USER_AGENT=Capitol Library Management System/1.0 (your-email@gmail.com)

# ==========================================================
# SMS NOTIFICATIONS CONFIGURATION
# Choose your provider: 'iprogsms', 'httpsms', 'textbee', or 'semaphore'
# ==========================================================
SMS_PROVIDER=iprogsms

# OPTION 1: iProgSMS (https://www.iprogsms.com)
IPROGSMS_API_TOKEN=your-iprogsms-api-token
IPROGSMS_PROVIDER=0
IPROGSMS_SENDER_NAME=

# OPTION 2: HttpSMS (Google Play Store App - Uses your SIM load)
# 1. Install "HttpSMS" from Google Play Store on your Android phone
# 2. Get API key from app or https://httpsms.com/settings
HTTPSMS_API_KEY=uk_sCoiEX4NylfdwT9Bd6PeHA5x3GvNq9Rw9bTuW4CzWq_KOJaoX8x2hn-pIkjHQhmP
HTTPSMS_FROM_NUMBER=+639514531630


